# Use the in-browser mock instead of Supabase + backend (UI development only)
VITE_USE_MOCK=true
# Mock only: show the CRM sync as "pending" to preview the Zoho-down state
VITE_MOCK_ZOHO_FAIL=false

# Public values only. Never put Stripe/Zoho secrets or the Supabase service key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:4000
