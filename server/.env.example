# Copy to .env and fill in. Never commit .env. All keys must be TEST/sandbox keys.

PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase → Project Settings → API. The service role / secret key bypasses RLS: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Test mode) → Developers → API keys. Live keys are rejected at startup.
STRIPE_SECRET_KEY=sk_test_
# Printed by: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_

# Zoho: URLs depend on your data centre (.com, .in, .eu, .com.au, .jp, .ca)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_API_VERSION=v8
# api-console.zoho.com → Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Filled in by: npm run zoho:exchange-code -- <grant code>
ZOHO_REFRESH_TOKEN=
# true = every Zoho call fails, to demo the pending + retry path
ZOHO_SIMULATE_FAILURE=false

CRM_SYNC_MAX_ATTEMPTS=8
CRM_SYNC_INTERVAL_SECONDS=30

# Random secret for POST /api/admin/crm/retry (generate: openssl rand -hex 32)
ADMIN_API_TOKEN=
# Password the seed script sets for the two test clients (test only, 6+ chars)
SEED_TEST_PASSWORD=
